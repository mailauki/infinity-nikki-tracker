# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (one-time premium purchase)
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Create a product + one-time price in Stripe dashboard, paste the price ID here
STRIPE_PRICE_ID=price_...
# Get this after creating a webhook endpoint pointing to /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: used to build absolute URLs in checkout redirects
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# OAuth providers (Google + Discord)
#
# These are read by the LOCAL Supabase stack via supabase/config.toml, not by
# Next.js — nothing in app/ imports them. In production the same values live in
# the Supabase dashboard (Authentication -> Providers) instead, so don't go
# looking for them in Vercel's env settings.
#
# Only needed to test OAuth against `supabase start` locally. The app builds and
# runs fine without them; the sign-in buttons just error on click.
#
# Google:  https://console.cloud.google.com/apis/credentials
# Discord: https://discord.com/developers/applications -> OAuth2
# Both need this redirect URI registered:
#   https://<project-ref>.supabase.co/auth/v1/callback
# and for local testing also:
#   http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
SUPABASE_AUTH_EXTERNAL_DISCORD_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_DISCORD_SECRET=
